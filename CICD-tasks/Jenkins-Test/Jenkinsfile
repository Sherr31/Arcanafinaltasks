pipeline {
    agent any
    
    options {
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }
    
    environment {
        DOCKERHUB_USERNAME = credentials('dockerhub-credentials-username')
        DOCKER_IMAGE_NAME = 'docker'
        DOCKER_IMAGE_TAG = "${BUILD_NUMBER}-${GIT_COMMIT.take(7)}"
        DOCKER_FULL_IMAGE = "${DOCKERHUB_USERNAME}/${DOCKER_IMAGE_NAME}"
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo "========================================="
                echo "📥 Checking out code from GitHub"
                echo "========================================="
                checkout scm
                sh '''
                    echo "Branch: ${GIT_BRANCH}"
                    echo "Commit: ${GIT_COMMIT}"
                    git log --oneline -1
                '''
            }
        }
        
        stage('Verify Dockerfile') {
            steps {
                echo "========================================="
                echo "🔍 Verifying Dockerfile exists"
                echo "========================================="
                sh '''
                    if [ -f Dockerfile ]; then
                        echo "✅ Dockerfile found"
                        echo "Contents:"
                        cat Dockerfile
                    else
                        echo "❌ Dockerfile not found!"
                        exit 1
                    fi
                '''
            }
        }
        
        stage('Build Docker Image') {
            steps {
                echo "========================================="
                echo "🔨 Building Docker image"
                echo "========================================="
                sh '''
                    echo "Building: ${DOCKER_FULL_IMAGE}:${DOCKER_IMAGE_TAG}"
                    docker build \
                        -t ${DOCKER_FULL_IMAGE}:${DOCKER_IMAGE_TAG} \
                        -t ${DOCKER_FULL_IMAGE}:latest \
                        -t ${DOCKER_FULL_IMAGE}:${GIT_BRANCH} \
                        .
                    
                    echo "✅ Image built successfully"
                    docker images | grep ${DOCKER_IMAGE_NAME}
                '''
            }
        }
        
        stage('Login to DockerHub') {
            steps {
                echo "========================================="
                echo "🔐 Authenticating with DockerHub"
                echo "========================================="
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                        echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                        echo "✅ Successfully logged in to DockerHub"
                    '''
                }
            }
        }
        
        stage('Push to DockerHub') {
            steps {
                echo "========================================="
                echo "📤 Pushing image to DockerHub"
                echo "========================================="
                sh '''
                    echo "Pushing: ${DOCKER_FULL_IMAGE}:${DOCKER_IMAGE_TAG}"
                    docker push ${DOCKER_FULL_IMAGE}:${DOCKER_IMAGE_TAG}
                    
                    echo "Pushing: ${DOCKER_FULL_IMAGE}:latest"
                    docker push ${DOCKER_FULL_IMAGE}:latest
                    
                    echo "Pushing: ${DOCKER_FULL_IMAGE}:${GIT_BRANCH}"
                    docker push ${DOCKER_FULL_IMAGE}:${GIT_BRANCH}
                    
                    echo "✅ All images pushed successfully"
                '''
            }
        }
        
        stage('Logout') {
            steps {
                sh 'docker logout'
            }
        }
    }
    
    post {
        always {
            echo "========================================="
            echo "🧹 Cleanup"
            echo "========================================="
            sh 'docker image prune -f'
        }
        
        success {
            echo "========================================="
            echo "✅ BUILD SUCCESSFUL!"
            echo "========================================="
            echo "Image: ${DOCKER_FULL_IMAGE}:${DOCKER_IMAGE_TAG}"
            echo "Also tagged as:"
            echo "  - ${DOCKER_FULL_IMAGE}:latest"
            echo "  - ${DOCKER_FULL_IMAGE}:${GIT_BRANCH}"
            echo ""
            echo "View on DockerHub:"
            echo "https://hub.docker.com/r/${DOCKERHUB_USERNAME}/${DOCKER_IMAGE_NAME}"
            echo "========================================="
        }
        
        failure {
            echo "========================================="
            echo "❌ BUILD FAILED"
            echo "========================================="
            echo "Check logs for details"
            echo "========================================="
        }
    }
}
